{
  "name": "internal",
  "version": "3.0.0",
  "description": "A curated set of high-quality, well-tested browser modules",
  "keywords": [
    "browser",
    "modules"
  ],
  "scripts": {
    "test": "make test",
    "build": "make build",
    "prepublishOnly": "[[ -z \"$PUBLISH\" ]] && { echo \"Refusing to publish. Run 'make publish' instead.\"; exit 1; } || exit 0;"
  },
  "author": "Matt Mueller",
  "license": "MIT",
  "devDependencies": {
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-istanbul": "3.2.4",
    "msw": "2.11.0",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./*": {
      "import": "./dist/*/index.mjs",
      "types": "./dist/*/index.d.mts"
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "printWidth": 240
  }
}